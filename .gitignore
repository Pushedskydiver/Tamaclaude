# Build output
dist/
*.tsbuildinfo
**/firmware/build/

# Coverage
coverage/

# Dependencies
node_modules/

# Credentials — never commit
.env*
!.env.example

# Editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Personal packs — logos, pets and in-jokes stay off the public internet.
# `packs/example/` is the one committed pack and documents the format.
# See docs/ARCHITECTURE.md §Packs.
packs/*
!packs/example/
!packs/example/**

# Claude Code — reusable agent definitions only.
#
# `.claude/research/` was tracked and is not any more. The briefs and specs in
# there carry the recipient's pet, their interests and every in-joke verbatim,
# and this repository is public. The risk register in
# BUILD_PLAN.md claimed `packs/` being gitignored kept that material off the
# internet; it never did, because the specs were never in `packs/`.
.claude/*
!.claude/agents/
!.claude/agents/**

# Rendered animation frames — regenerate with tools/svg2frames.ts
out/

# ESP-IDF build output and the generated sdkconfig. `sdkconfig.defaults` is the
# tracked source of truth; `sdkconfig` is derived from it plus the chosen
# target and is regenerated by `idf.py set-target`. The build directory is
# ~200MB per firmware.
packages/device/firmware/*/build/
packages/device/firmware/*/sdkconfig
packages/device/firmware/*/sdkconfig.old
